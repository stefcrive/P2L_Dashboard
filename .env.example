# Local Supabase
# `npm run dev:local` reads the actual keys from `supabase status` and injects
# them into the frontend process. These values document the expected shape only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=read-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=read-from-supabase-status
SUPABASE_LOCAL_ONLY=true

# Scientific API
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://localhost:6379
SECRET_KEY=replace-with-a-local-development-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File upload configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=.txt,.csv,.xlsx,.dat,.xls

# Scientific computing
DEFAULT_PRECISION=0.05
CALIBRATION_STANDARDS_PATH=./standards/

# P2L Assistant (server-side only)
OPENAI_API_KEY=replace-with-your-openai-api-key
# Defaults to gpt-5.6-sol when omitted.
OPENAI_MODEL=gpt-5.6-sol

# Local Knowledge Base (PGlite/PostgreSQL; no Docker required)
KNOWLEDGE_DB_PATH=./.local-data/knowledge-postgres
KNOWLEDGE_SOURCE_PATH=./Merged_text_files
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_ENRICHMENT_MODEL=gpt-5.6-luna
KNOWLEDGE_ANSWER_MODEL=gpt-5.6-terra
KNOWLEDGE_MAX_SOURCE_FILE_MB=32
KNOWLEDGE_MAX_CHUNKS_PER_FILE=10000

# Operational application database (default: embedded PostgreSQL, no Docker)
APP_DATABASE_MODE=local
APP_DATABASE_PATH=./.local-data/app-postgres

# Local source folders
CLIENTI_FOLDER_PATH=../Clienti
RESULTS_FOLDER_PATH=../Results
MANTAINANCE_FOLDER_PATH=../Mantainance

# Email configuration (optional)
SMTP_SERVER=smtp.example.invalid
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
